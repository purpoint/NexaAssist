# NexaAssist environment configuration.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# Only variables actually consumed by the current codebase are listed here;
# new variables must be added alongside the code that reads them.

# ---------- Application ----------
# Human-readable service name, shown in API docs and health responses.
APP_NAME=NexaAssist
# Deployment environment: local | development | staging | production
APP_ENV=local
# Enables verbose errors and auto-reload friendly behaviour. Never true in production.
DEBUG=true

# ---------- HTTP server ----------
API_HOST=127.0.0.1
API_PORT=8000
# Path prefix applied to all API routes. Version 1 is served at ${API_PREFIX}/v1.
API_PREFIX=/api
# Serve the pre-v1 alias GET /api/health alongside GET /api/v1/health.
# Deprecated and scheduled for removal in milestone M2; set to false to verify
# nothing still depends on it. See docs/architecture.md.
ENABLE_LEGACY_HEALTH_ROUTE=true

# ---------- Logging ----------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---------- Language model ----------
# Which provider implementation to use: groq | static
# "static" returns deterministic canned responses and makes no network calls --
# use it for local development or CI without credentials.
LLM_PROVIDER=groq
# Structured output support is model-dependent on Groq. Models supporting
# strict-mode constrained decoding: openai/gpt-oss-20b, openai/gpt-oss-120b,
# qwen/qwen3.8-27b.
LLM_MODEL=openai/gpt-oss-120b
# Applies per attempt, not to the whole call. Worst-case wall clock for one
# request is LLM_TIMEOUT_SECONDS * (LLM_MAX_RETRIES + 1).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Ceiling for one complete call, including retry backoff sleep. Must be at
# least LLM_TIMEOUT_SECONDS. A real call took 34.8s after a server-directed
# retry-after, so this is not the same as the per-attempt timeout.
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
# Optional and provider-agnostic. Left unset it is not sent at all.
LLM_TEMPERATURE=

# ---------- Database ----------
# The async driver is required; a postgresql:// URL is rejected at startup.
# Leave empty to run the service without a database.
# This value is credential-free by design -- a URL with a password belongs in
# .env (git-ignored), never here.
DATABASE_URL=postgresql+asyncpg://localhost:5432/nexaassist
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Echoes SQL and bound parameters, which can include customer data.
# Never true in production.
DB_ECHO=false

# ---------- Retrieval ----------
# Embedding provider: fastembed | hashing
# "fastembed" runs a local ONNX model (downloaded on first use, no API key).
# "hashing" is deterministic and offline -- what the test suite uses.
EMBEDDING_PROVIDER=fastembed
# Chunks returned by a retrieval before an answer is composed.
RETRIEVAL_TOP_K=4

# ---------- Agent ----------
# What one agent run may spend before it stops and answers with what it has.
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8

# ---------- Secrets ----------
# Leave this EMPTY here. Put the real key only in .env (git-ignored) or export
# it in your shell. Never commit a key, and never paste one into this file.
# Blank means "unset", so the SDK falls back to the GROQ_API_KEY it reads from
# the environment itself.
GROQ_API_KEY=

# Do NOT set GROQ_LOG=debug outside local debugging: the SDK's debug logging
# is verbose about request contents.

# ---------- Frontend ----------
# Base URL the React client uses to reach the backend.
# Vite only exposes variables prefixed with VITE_ to browser code.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
