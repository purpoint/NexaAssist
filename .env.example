# NexaAssist environment configuration.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# Only variables actually consumed by the current codebase are listed here;
# new variables must be added alongside the code that reads them.

# ---------- Application ----------
# Human-readable service name, shown in API docs and health responses.
APP_NAME=NexaAssist
# Deployment environment: local | development | staging | production
APP_ENV=local
# Enables verbose errors and auto-reload friendly behaviour. Never true in production.
DEBUG=true

# ---------- HTTP server ----------
API_HOST=127.0.0.1
API_PORT=8000
# Path prefix applied to all API routes. Version 1 is served at ${API_PREFIX}/v1.
API_PREFIX=/api
# Serve the pre-v1 alias GET /api/health alongside GET /api/v1/health.
# Deprecated and scheduled for removal in milestone M2; set to false to verify
# nothing still depends on it. See docs/architecture.md.
ENABLE_LEGACY_HEALTH_ROUTE=true

# ---------- Logging ----------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
# Base URL the React client uses to reach the backend.
# Vite only exposes variables prefixed with VITE_ to browser code.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
